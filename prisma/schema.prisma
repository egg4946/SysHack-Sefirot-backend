generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // sqlite から変更
  url      = env("DATABASE_URL")
}

// 1. ユーザー
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String
  displayName    String
  createdAt      DateTime @default(now())

  communityMembers CommunityMember[]
  assignedTasks    TaskAssignee[]
  createdTasks     Task[]            @relation("TaskCreator")
  chatMessages     ChatMessage[]     // ✨ 新規: チャットとの繋がり
  taskComments     TaskComment[]
}

// 2. コミュニティ
model Community {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdBy  String
  createdAt  DateTime @default(now())

  members      CommunityMember[]
  tasks        Task[]
  chatMessages ChatMessage[]       // ✨ 新規: チャットとの繋がり
}

// 3. コミュニティ所属情報
model CommunityMember {
  id                   String @id @default(uuid())
  userId               String
  communityId          String
  communityDisplayName String

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
}

// 4. タスク
model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  progress    Int       @default(0)
  parentId    String?
  communityId String
  createdBy   String
  status      String    @default("未着手")
  priority    String    @default("中")
  deadline    DateTime?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id])
  creator   User      @relation("TaskCreator", fields: [createdBy], references: [id])
  parent    Task?     @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Task[]    @relation("TaskHierarchy")

  assignees  TaskAssignee[]
  checklists Checklist[]
  comments    TaskComment[]
}

// 5. タスク担当者と「個人進捗度」
model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  progress  Int      @default(0)
  comment   String?  // ✨ 新規追加: 進捗に添える一言コメント（入力しないこともあるのでオプショナル `?` にします）
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// 6. チェックリスト
model Checklist {
  id          String  @id @default(uuid())
  taskId      String
  content     String
  isCompleted Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// 7. ✨ 新規追加: プロジェクト全体のチャットメッセージ ✨
model ChatMessage {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  content     String
  imageUrl    String?  // 画像URL（今回は文章のみの実装ですが、将来のために一応箱だけ作っておきます！）
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// タスクごとのコメントテーブル
model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  // リレーション（タスクやユーザーが消えたらコメントも一緒に消える設定）
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
