generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. ユーザー
model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String
  displayName    String
  createdAt      DateTime @default(now())

  // リレーション（他のテーブルとの繋がり）
  communityMembers CommunityMember[]
  assignedTasks    Task[]            @relation("TaskAssignees")
  createdTasks     Task[]            @relation("TaskCreator")
}

// 2. コミュニティ
model Community {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdBy  String
  createdAt  DateTime @default(now())

  members CommunityMember[]
  tasks   Task[]
}

// 3. コミュニティ所属情報 (多対多の中間テーブル)
model CommunityMember {
  id          String @id @default(uuid())
  userId      String
  communityId String

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
}

// 4. タスク (Sefirotの核となる階層構造)
model Task {
  id          String    @id @default(uuid())
  title       String // YAMLの "name" に対応する部分（APIで変換して返します）
  description String?
  progress    Int       @default(0)
  parentId    String?
  communityId String
  createdBy   String
  status      String    @default("未着手") // YAMLで追加した状態管理
  priority    String    @default("中") // YAMLで追加した優先度
  deadline    DateTime? // 旧 dueDate
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id])
  creator   User      @relation("TaskCreator", fields: [createdBy], references: [id])
  parent    Task?     @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Task[]    @relation("TaskHierarchy")

  assignees  User[]      @relation("TaskAssignees") // 複数人アサイン対応
  checklists Checklist[]
}

model Checklist {
  id          String  @id @default(uuid())
  taskId      String
  content     String
  isCompleted Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
